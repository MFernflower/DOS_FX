# Define the assembler to use
ASSEMBLER = fasm

# Define the source and output directories
SRC_DIR = .
BIN_DIR = bin_out

# Define the source files
ASM_SOURCES := $(wildcard $(SRC_DIR)/*.asm $(SRC_DIR)/*.ASM)

# Define the output files (.com) based on the source files
COM_OUTPUTS := $(patsubst %.asm, %.com, $(patsubst %.ASM, %.COM, $(notdir $(ASM_SOURCES))))

.PHONY: all clean

all: $(BIN_DIR) $(addprefix $(BIN_DIR)/,$(COM_OUTPUTS))

# Rule to assemble source files into .com
$(BIN_DIR)/%.com: %.asm | $(BIN_DIR)
	$(ASSEMBLER) $<

$(BIN_DIR)/%.COM: %.ASM | $(BIN_DIR)
	$(ASSEMBLER) $<

# Rule to create the bin_out directory
$(BIN_DIR):
	mkdir -p $(BIN_DIR)

# Rule to clean up generated files and directory
clean:
	rm -f $(BIN_DIR)/*.{com,COM}
	rmdir --ignore-fail-on-non-empty $(BIN_DIR)
